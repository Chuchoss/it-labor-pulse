# =============================================================================
# Labor Market Analytics (LMA) — пример переменных окружения
#
# cp .env.example .env  → заполните локально.
# НИКОГДА не коммитьте реальные секреты: ни в .env, ни в compose/k8s YAML.
# Файл .env в .gitignore. Сюда — только placeholders / безопасные local-dummy.
#
# DX:      docs/architecture/12-local-dev.md
# Secrets: docs/architecture/17-secrets-management.md
# =============================================================================

# --- App / logging ---
LOG_LEVEL=info
# ENV: local | dev | stage | prod
APP_ENV=local
# OpenTelemetry (Phase 2�3; optional). Docs: docs/architecture/23-observability-tracing.md
# OTEL_SERVICE_NAME=bff
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_SAMPLER=always_on
# OTEL_TRACES_SAMPLER_ARG=1.0

# --- HeadHunter (обязательно для реального ingest) ---
# Идентифицирующий User-Agent с контактом — требование HH API.
# Пример: LMAStudyProject/0.1 (+https://github.com/<user>/study_project; you@example.com)
HH_USER_AGENT=
HH_BASE_URL=https://api.hh.ru
# Опционально: application token (только server-side)
HH_APP_TOKEN=

# --- Admin ---
# Заголовок X-Admin-Token для /api/v1/admin/*
# Значение ниже — только local dummy; для stage/prod — свой сильный токен (не этот).
ADMIN_TOKEN=dev-admin-token

# =============================================================================
# PostgreSQL (OLTP)
#
# Рекомендуемый путь: облачный / managed Postgres (Neon, Supabase, Yandex Cloud
# Managed PostgreSQL trial, Timeweb Cloud и т.п. — проверь актуальные free tier).
# Можно сочетать с облачным Redis (см. ниже) — тогда Compose infra не нужна:
# make up-cloud.
#
# 1) Создай проект/БД у провайдера.
# 2) Скопируй connection string в DATABASE_URL ниже (в свой .env, не в git).
# 3) Для облака почти всегда нужен SSL: sslmode=require (иногда verify-full).
# 4) Дискретные POSTGRES_* можно заполнить теми же host/user/db для GUI (DBeaver).
#
# НИКОГДА не коммить реальный DATABASE_URL с паролем.
# =============================================================================

# --- Вариант A (рекомендуется): cloud / managed ---
# Подставь свой URL из кабинета провайдера. Примеры-плейсхолдеры (не рабочие):
# Neon:     postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Supabase: postgres://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
# Yandex / Timeweb: postgres://USER:PASSWORD@HOST:6432/DBNAME?sslmode=require
#
# Раскомментируй и замени в .env (не в этом example-файле с реальными данными):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Вариант B: локальный Postgres в Docker (profile local-pg) ---
# make up-local-pg  или  make up-local (вместе с local Redis).
# Для local SSL обычно не нужен:
DATABASE_URL=postgres://lma:lma_local_password@localhost:5432/lma?sslmode=disable

# Дискретные поля (GUI, compose env для local-pg, fallback если сервис не читает DSN):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lma
# Local-only placeholder; не используйте этот пароль вне ноутбука / не для cloud.
POSTGRES_PASSWORD=lma_local_password
POSTGRES_DB=lma

# =============================================================================
# Redis (cache + locks)
#
# Preferred для РФ: Yandex Managed Valkey (бывш. Managed Redis), rediss://.
# Альтернативы РФ: Selectel / Timeweb Cloud / VK Cloud.
# Опционально: Redis Cloud (если доступен). Upstash — может быть недоступен из РФ.
# Реестр: docs/architecture/21-external-services.md
# Шаги Yandex: docs/architecture/12-local-dev.md (Облачный Redis)
#
# 1) Создай managed Redis/Valkey (Yandex и т.п.; тарифы — в кабинете).
# 2) Скопируй host/port/password в REDIS_URL в своём .env (не в git).
# 3) Managed с TLS → схема rediss:// (две s). Yandex TLS часто порт 6380.
# 4) Yandex: скачай CA и укажи REDIS_TLS_CA_FILE (см. 12-local-dev).
# 5) Без TLS (local Docker): redis://
#
# НИКОГДА не коммить реальный REDIS_URL с паролем.
# =============================================================================

# --- Вариант A (preferred РФ): Yandex Managed Valkey / любой managed rediss:// ---
# Плейсхолдеры (не рабочие). Раскомментируй и подставь в .env:
# REDIS_URL=rediss://:PASSWORD@c-CLUSTER_ID.rw.mdb.yandexcloud.net:6380/0
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT/0
# REDIS_TLS_CA_FILE=C:\Users\YOU\.redis\YandexInternalRootCA.crt
#
# Selectel / Timeweb / VK Cloud / Redis Cloud — тот же формат rediss:// из кабинета.
# Upstash (если доступен): rediss://default:PASSWORD@REGION.upstash.io:PORT
# redis://  — без TLS;  rediss:// — с TLS (go-redis / BFF health).

# --- Вариант B: локальный Redis в Docker (profile local-redis, fallback) ---
# make up-local-redis  или  make up-local
REDIS_URL=redis://localhost:6379/0
# REDIS_TLS_CA_FILE=

# Дискретные поля (GUI, fallback если клиент не читает URL):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
# Local обычно пусто; cloud — пароль из кабинета (или только внутри REDIS_URL).
REDIS_PASSWORD=
CACHE_TTL_SUMMARY_SEC=300
CACHE_TTL_TRENDS_SEC=600
INGEST_LOCK_TTL_SEC=2700

# --- Service listen addresses (host / local process) ---
# Public MVP edge = BFF :8080 (ADR 010 revised). Separate gateway = Target Phase 3+.
# BFF: BFF_HTTP_ADDR; aliases BFF_PORT / PORT (bare "8080" or ":8080").
BFF_HTTP_ADDR=:8080
# BFF_PORT=8080
QUERY_HTTP_ADDR=:8083
QUERY_GRPC_ADDR=:9091
INGEST_HTTP_ADDR=:8082
INGEST_GRPC_ADDR=:9092

# --- Internal service URLs (для bff → query/ingest) ---
QUERY_GRPC_TARGET=localhost:9091
INGEST_GRPC_TARGET=localhost:9092
# Phase 1: bff может ходить в query по HTTP debug — опционально
# QUERY_HTTP_BASE=http://localhost:8083

# --- Kafka / Redpanda (Phase 2; local рекомендуем host port 19092) ---
KAFKA_BROKERS=localhost:19092
KAFKA_CONSUMER_GROUP_NORMALIZER=lma-normalizer

# --- ClickHouse (Phase 2) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=lma
# CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/lma

# --- FX / normalization (опционально) ---
# Базовая валюта отчётов
REPORT_CURRENCY=RUB
# Источник курсов: static|cbr|manual
FX_PROVIDER=static
# Максимум дней поиска предыдущего rate; после него Phase 1 оставляет salary_mid_rub пустым.
FX_MAX_FALLBACK_DAYS=7
# Запасной курс USD→RUB если нет свежего (только local/dev)
FX_USD_RUB_FALLBACK=90
SALARY_TAX_RATE=0.13
SALARY_NORMALIZE_TO=net
SALARY_OUTLIER_MIN_RUB=10000
SALARY_OUTLIER_MAX_RUB=2000000

# --- Ingest defaults (local smoke) ---
# one-shot: make ingest-hh  |  offline: make ingest-hh-fixture
# query: один целевой text/area запрос; it: официальный IT-каталог HH, Россия (area 113).
INGEST_SCOPE=query
INGEST_DEFAULT_AREA=1
INGEST_DEFAULT_TEXT=golang
# Пауза между запросами HH (search и detail); 429 дополнительно уважает Retry-After/backoff.
INGEST_PAGE_DELAY_MS=350
# 0 или all: все страницы, которые HH сообщает для одного настроенного запроса.
# Всё равно действуют лимит глубины HH 2000 результатов и hard ceiling 100 страниц.
INGEST_MAX_PAGES=5
# HH допускает 1..100; 100 уменьшает число поисковых запросов (до 20 страниц на 2000).
INGEST_PER_PAGE=100
INGEST_RUN_TIMEOUT_SEC=1800
# Safety ceilings для явного INGEST_SCOPE=it. Планировщик сначала делит каждую
# IT-роль по времени, пока leaf <= официального лимита выдачи 2000.
INGEST_IT_AREA=113
INGEST_IT_MAX_DEPTH=32
INGEST_IT_MAX_PARTITIONS=512
INGEST_IT_MAX_REQUESTS=500
# Optional fixture dir (default testdata/hh with -fixture / make ingest-hh-fixture)
# INGEST_FIXTURE_DIR=

# --- AI (Target / Phase 4) — не заполнять без нужды ---
# Реальный ключ только в .env / K8s Secret; никогда не коммитить и не логировать.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini


# --- Observability Compose profile (optional: make up-obs / --profile observability) ---
# Docs: docs/architecture/23-observability-tracing.md
# GRAFANA_PORT=3001
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# LOKI_PORT=3100
# PROMETHEUS_PORT=9090
# OTEL_HOST_PORT_GRPC=4317
# OTEL_HOST_PORT_HTTP=4318
# Grafana Cloud (later; never commit real tokens):
# GRAFANA_CLOUD_OTLP_ENDPOINT=
# GRAFANA_CLOUD_INSTANCE_ID=
# GRAFANA_CLOUD_API_TOKEN=
# --- Web (Vite) ---
# Публичный same-origin путь; dev proxy отправляет /api на BFF :8080.
# Для отдельного deployment можно задать публичный URL BFF (без токенов).
VITE_API_BASE_URL=/api/v1
